{\n    this.width = NODE_WIDTH\n    this.height = NODE_HEIGHT + 13 * 2\n    this.text.editable = false\n    this.sourceRules.push({\n      message: '只允许从右边的锚点连出',\n      validate: (sourceNode, targetNode, sourceAnchor, targetAnchor) => {\n        return targetAnchor.type === 'incomming'\n      }\n    })\n  }\n  setHeight(val) {\n    this.height = val\n  }\n  getOutlineStyle() {\n    const style = super.getOutlineStyle()\n    style.stroke = 'none'\n    style.hover.stroke = 'none'\n    return style\n  }\n  getDefaultAnchor() {\n    const { id, x, y, width, height } = this\n    const anchors = []\n    anchors.push({\n      x: x - width / 2,\n      y,\n      id: `${id}_incomming`,\n      edgeAddable: false,\n      type: 'incomming'\n    })\n    anchors.push({\n      x: x + width / 2,\n      y,\n      id: `${id}_outgoing`,\n      type: 'outgoing'\n    })\n    return anchors\n  }\n  addNode(node, nextY = 0) {\n    const isDeep = nextY !== 0\n    const nodeModel = this.graphModel.getNodeModelById(node.sourceId)\n    const leftTopX = node.x + NEXT_X_DISTANCE - 50 - 10\n    const leftTopY = node.y + nextY - 40 - 8\n    const rightBottomX = node.x + NEXT_X_DISTANCE + 50 + 10\n    const rightBottomY = node.y + nextY + 40 + 8\n    const existElements = this.graphModel.getAreaElement(\n      this.getHtmlPoint([leftTopX, leftTopY]),\n      this.getHtmlPoint([rightBottomX, rightBottomY])\n    )\n    if (existElements.length) {\n      this.addNode(node, nextY + NEXT_Y_DISTANCE)\n      return\n    }\n    const newNode = this.graphModel.addNode({\n      type: node.type,\n      x: node.x + NEXT_X_DISTANCE,\n      y: node.y + nextY,\n      properties: node.properties\n    })\n    let startPoint\n    let endPoint\n    if (isDeep) {\n      startPoint = {\n        x: node.x,\n        y: node.y + nodeModel.height / 2\n      }\n      endPoint = {\n        x: newNode.x - newNode.width / 2,\n        y: newNode.y\n      }\n    }\n    this.graphModel.addEdge({\n      sourceNodeId: node.sourceId,\n      targetNodeId: newNode.id,\n      startPoint,\n      endPoint\n    })\n    this.graphModel.selectElementById(newNode.id)\n    this.graphModel.showContextMenu(newNode)\n  }\n}\n\nexport default {\n  type: 'base-node',\n  model: BaseNodeModel,\n  view: BaseNodeView\n}\n"],"mappings":";;;;;;;AACA,SAASA,QAAQ,EAAEC,aAAa,EAAEC,CAAC,QAAQ,iBAAiB;AAC5D,SAASC,UAAU,EAAEC,WAAW,QAAQ,kBAAkB;AAC1D,OAAOC,QAAQ,MAAM,gBAAgB;AAErC,IAAMC,eAAe,GAAG,GAAG;AAC3B,IAAMC,eAAe,GAAG,GAAG;AAAA,IAErBC,YAAY,0BAAAC,SAAA;EAChB,SAAAD,aAAYE,KAAK,EAAE;IAAA,IAAAC,KAAA;IAAAC,eAAA,OAAAJ,YAAA;IACjBG,KAAA,GAAAE,UAAA,OAAAL,YAAA,GAAME,KAAK;IACXC,KAAA,CAAKG,IAAI,GAAGC,QAAQ,CAACC,aAAa,CAAC,KAAK,CAAC;IACzCL,KAAA,CAAKM,YAAY,GAAGZ,QAAQ;IAAA,OAAAM,KAAA;EAC9B;EAACO,SAAA,CAAAV,YAAA,EAAAC,SAAA;EAAA,OAAAU,YAAA,CAAAX,YAAA;IAAAY,GAAA;IAAAC,KAAA,EACD,SAAAC,YAAYA,CAAA,EAAG;MACb,IAAMC,IAAI,GAAAC,aAAA,CAAAA,aAAA,KACL,IAAI,CAACd,KAAK,CAACe,KAAK,CAACC,UAAU;QAC9BC,UAAU,EAAE,IAAI,CAACjB,KAAK,CAACe,KAAK,CAACE,UAAU;QACvCC,SAAS,EAAE,IAAI,CAAClB,KAAK,CAACe,KAAK,CAACG;MAAS,EACtC;MACD,IAAI,IAAI,CAACC,aAAa,IAAI,IAAI,CAACA,aAAa,KAAKC,IAAI,CAACC,SAAS,CAACR,IAAI,CAAC,EAAE;MACvE,IAAI,CAACM,aAAa,GAAGC,IAAI,CAACC,SAAS,CAACR,IAAI,CAAC;MACzC,OAAO,IAAI;IACb;EAAC;IAAAH,GAAA;IAAAC,KAAA,EACD,SAAAW,OAAOA,CAACC,MAAM,EAAE;MAAA,IAAAC,MAAA;MACdD,MAAM,CAACE,WAAW,CAAC,IAAI,CAACrB,IAAI,CAAC;MAC7B,IAAI,IAAI,CAACsB,EAAE,EAAE;QACX,IAAI,CAACA,EAAE,CAACC,MAAM,CAAC,IAAI,CAACvB,IAAI,CAAC;MAC3B,CAAC,MAAM;QACL,IAAI,CAACsB,EAAE,GAAG,IAAIE,GAAG,CAAC;UAChBC,MAAM,EAAE,SAARA,MAAMA,CAAGrC,CAAC;YAAA,OACRA,CAAC,CAACgC,MAAI,CAACjB,YAAY,EAAE;cACnBP,KAAK,EAAE;gBACLe,KAAK,EAAES,MAAI,CAACxB,KAAK,CAACe,KAAK;gBACvBe,UAAU,EAAEN,MAAI,CAACxB,KAAK,CAAC8B,UAAU;gBACjCC,QAAQ,EAAEP,MAAI,CAACxB,KAAK,CAAC8B,UAAU,CAACE,eAAe,CAACC,YAAY;gBAC5DhB,UAAU,EAAEO,MAAI,CAACxB,KAAK,CAACe,KAAK,CAACE,UAAU;gBACvCC,SAAS,EAAEM,MAAI,CAACxB,KAAK,CAACe,KAAK,CAACG,SAAS;gBACrCF,UAAU,EAAEQ,MAAI,CAACxB,KAAK,CAACe,KAAK,CAACmB,aAAa,CAAC;cAC7C;YACF,CAAC,CAAC;UAAA;QACN,CAAC,CAAC;QACF,IAAI,CAACR,EAAE,CAACC,MAA