{"remainingRequest":"/home/fk/workspace/github/front/base-aiflow/node_modules/vue-loader/lib/index.js??vue-loader-options!/home/fk/workspace/github/front/base-aiflow/src/packages/organizer/tool/fieldSelector/index.vue?vue&type=style&index=0&id=280a8884&scoped=true&lang=less","dependencies":[{"path":"/home/fk/workspace/github/front/base-aiflow/src/packages/organizer/tool/fieldSelector/index.vue","mtime":1753520642087},{"path":"/home/fk/workspace/github/front/base-aiflow/node_modules/css-loader/dist/cjs.js","mtime":1753520773705},{"path":"/home/fk/workspace/github/front/base-aiflow/node_modules/vue-loader/lib/loaders/stylePostLoader.js","mtime":1753520774422},{"path":"/home/fk/workspace/github/front/base-aiflow/node_modules/postcss-loader/src/index.js","mtime":1753520773937},{"path":"/home/fk/workspace/github/front/base-aiflow/node_modules/less-loader/dist/cjs.js","mtime":1753521743036},{"path":"/home/fk/workspace/github/front/base-aiflow/node_modules/cache-loader/dist/cjs.js","mtime":1753520773253},{"path":"/home/fk/workspace/github/front/base-aiflow/node_modules/vue-loader/lib/index.js","mtime":1753520774078}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:CgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCi9kZWVwLy5lbC1jYXNjYWRlciB7CiAgd2lkdGg6IDEwMCU7Cn0K"},{"version":3,"sources":["index.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAsEA;AACA;AACA","file":"index.vue","sourceRoot":"src/packages/organizer/tool/fieldSelector","sourcesContent":["<template>\n  <div >\n    <el-cascader\n      ref=\"fieldSelector\"\n      v-model=\"val\"\n      size=\"small\"\n      placeholder=\"请选择字段\"\n      :options=\"options\"\n      :props=\"{ expandTrigger: 'click', checkStrictly: true }\"\n      @change=\"handleChange\"\n      >\n    </el-cascader>\n  </div>\n</template>\n\n<script>\nexport default {\n  props: {\n    body: Object,\n    value: String,\n  },\n  data () {\n    return {\n      val: ''\n    }\n  },\n  watch: {\n    value: {\n      immediate: true,\n      deep: true,\n      handler (nv) {\n        this.val = this.value && this.value.split('.')  || []\n      }\n    },\n  },\n  computed: {\n    options() {\n      const tree = []\n      const genTree = (body, list) => {\n        if (body.properties) {\n          for(let prop in body.properties) {\n            const node = {\n              label: prop,\n              value: prop,\n              dataType: body.properties[prop].type\n            }\n            list.push(node)\n            if (body.properties[prop].properties) {\n              node.children = []\n              genTree(body.properties[prop], node.children)\n            }\n          }\n        }\n      }\n      genTree(this.body, tree)\n      return tree\n    }\n  },\n  methods: {\n    // 选择组件后获取组件值\n    handleChange(e) {\n      const checkedNodes =  this.$refs['fieldSelector'].getCheckedNodes();\n      const data = checkedNodes[0].data || {} \n      this.$emit('change', e, data.dataType)\n    }\n  }\n}\n</script>\n\n<style scoped lang=\"less\">\n/deep/.el-cascader {\n  width: 100%;\n}\n</style>"]}]}