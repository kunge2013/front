n  data () {\n    return {\n      val: ''\n    }\n  },\n  watch: {\n    value: {\n      immediate: true,\n      deep: true,\n      handler (nv) {\n        this.val = this.value && this.value.split('.')  || []\n      }\n    },\n  },\n  computed: {\n    options() {\n      const tree = []\n      const genTree = (body, list) => {\n        if (body.properties) {\n          for(let prop in body.properties) {\n            const node = {\n              label: prop,\n              value: prop,\n              dataType: body.properties[prop].type\n            }\n            list.push(node)\n            if (body.properties[prop].properties) {\n              node.children = []\n              genTree(body.properties[prop], node.children)\n            }\n          }\n        }\n      }\n      genTree(this.body, tree)\n      return tree\n    }\n  },\n  methods: {\n    // 选择组件后获取组件值\n    handleChange(e) {\n      const checkedNodes =  this.$refs['fieldSelector'].getCheckedNodes();\n      const data = checkedNodes[0].data || {} \n      this.$emit('change', e, data.dataType)\n    }\n  }\n}\n</script>\n\n<style scoped lang=\"less\">\n/deep/.el-cascader {\n  width: 100%;\n}\n</style>"],"mappings":";;;;;;;;;;;;;;;;AAgBA;EACAA,KAAA;IACAC,IAAA,EAAAC,MAAA;IACAC,KAAA,EAAAC;EACA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,GAAA;IACA;EACA;EACAC,KAAA;IACAJ,KAAA;MACAK,SAAA;MACAC,IAAA;MACAC,OAAA,WAAAA,QAAAC,EAAA;QACA,KAAAL,GAAA,QAAAH,KAAA,SAAAA,KAAA,CAAAS,KAAA;MACA;IACA;EACA;EACAC,QAAA;IACAC,OAAA,WAAAA,QAAA;MACA,IAAAC,IAAA;MACA,IAAAC,QAAA,YAAAA,QAAAf,IAAA,EAAAgB,IAAA;QACA,IAAAhB,IAAA,CAAAiB,UAAA;UACA,SAAAC,IAAA,IAAAlB,IAAA,CAAAiB,UAAA;YACA,IAAAE,IAAA;cACAC,KAAA,EAAAF,IAAA;cACAhB,KAAA,EAAAgB,IAAA;cACAG,QAAA,EAAArB,IAAA,CAAAiB,UAAA,CAAAC,IAAA,EAAAI;YACA;YACAN,IAAA,CAAAO,IAAA,CAAAJ,IAAA;YACA,IAAAnB,IAAA,CAAAiB,UAAA,CAAAC,IAAA,EAAAD,UAAA;cACAE,IAAA,CAAAK,QAAA;cACAT,QAAA,CAAAf,IAAA,CAAAiB,UAAA,CAAAC,IAAA,GAAAC,IAAA,CAAAK,QAAA;YACA;UACA;QACA;MACA;MACAT,QAAA,MAAAf,IAAA,EAAAc,IAAA;MACA,OAAAA,IAAA;IACA;EACA;EACAW,OAAA